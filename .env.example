# ===========================================
# Prime Champs Environment Variables
# ===========================================
# Copy this file to .env and fill in your values
# DO NOT commit .env to git!

# -------------------------------------------
# SUPABASE (Required)
# -------------------------------------------
# Get these from: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api

# Project URL - found in Settings > API
SUPABASE_URL=https://your-project.supabase.co

# Anon/Public key - safe for client-side
SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key

# Service Role key - server-side only, bypasses RLS
# KEEP THIS SECRET - never expose to client
SUPABASE_SERVICE_KEY=your-service-key
# Preferred current server key name (legacy service-role keys still work).
SUPABASE_SECRET_KEY=sb_secret_your-key

# -------------------------------------------
# AI APIs (Required for agents)
# -------------------------------------------
# Get from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-key

# Optional alternative AI provider. At least one of Anthropic or OpenAI is
# required for AI scoring and message drafting.
OPENAI_API_KEY=sk-your-openai-key

# Candidate discovery used by the dashboard research agent.
PERPLEXITY_API_KEY=pplx-your-key

# -------------------------------------------
# ENRICHMENT APIs
# -------------------------------------------
# Apify - Instagram scraping
# Get from: https://console.apify.com/account/integrations
APIFY_API_KEY=your-apify-key

# Firecrawl - Web crawling (optional)
# Get from: https://firecrawl.dev/
FIRECRAWL_API_KEY=your-firecrawl-key

# SerpAPI - Google search results (optional)
# Get from: https://serpapi.com/
SERPAPI_KEY=your-serpapi-key

# -------------------------------------------
# UNIFIED INBOX + CONNECTED ACCOUNTS
# -------------------------------------------
# Encrypts OAuth access/refresh tokens before they are stored in Supabase.
# Generate with: openssl rand -base64 32
CHANNEL_TOKEN_ENCRYPTION_KEY=your-32-byte-base64-key

# Reserved Google Cloud OAuth scaffolding. Gmail sync/sending adapters are not
# implemented yet; Exchange is the recommended primary mailbox.
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/providers/gmail/callback

# Microsoft Entra OAuth app (Outlook / Microsoft Graph)
MICROSOFT_CLIENT_ID=your-microsoft-client-id
MICROSOFT_CLIENT_SECRET=your-microsoft-client-secret
MICROSOFT_TENANT_ID=your-entra-tenant-id
MICROSOFT_REDIRECT_URI=http://localhost:3000/api/providers/outlook/callback
# Random secret returned with Microsoft Graph change notifications.
MICROSOFT_WEBHOOK_CLIENT_STATE=your-random-webhook-client-state

# Meta app for an Instagram professional account. The official messaging API
# handles user-initiated conversations and replies; it is not a cold-DM API.
META_APP_ID=your-meta-app-id
META_APP_SECRET=your-meta-app-secret
META_REDIRECT_URI=http://localhost:3000/api/providers/instagram/callback
META_VERIFY_TOKEN=your-meta-webhook-verify-token
META_API_VERSION=v24.0

# -------------------------------------------
# INSTAGRAM DM INTEGRATION (High risk)
# -------------------------------------------
# These enable direct Instagram access via instagrapi
# Risk of account ban - use with caution
#
# REQUIRED: Secret for encrypting stored Instagram sessions
# Generate with: openssl rand -base64 32
INSTAGRAM_SESSION_SECRET=your-session-encryption-secret

# OPTIONAL: Salt for key derivation (default: prime_champs_ig_salt)
# INSTAGRAM_SESSION_SALT=your-custom-salt

# Legacy vars (deprecated - use instagrapi auth instead)
# INSTAGRAM_SESSION_ID=
# INSTAGRAM_CSRF_TOKEN=

# -------------------------------------------
# DASHBOARD AUTH (Required)
# -------------------------------------------
# One-time legacy Zac credential used only by /setup to establish the first
# Supabase Auth owner. Remove it once setup completes; invite teammates in-app.
AUTH_USERS=zac:change-me:Zac

# JWT secret for session tokens. REQUIRED — the app refuses to start without
# it (no insecure fallback). Must be >= 32 chars.
# Generate with: openssl rand -hex 32
JWT_SECRET=your-jwt-secret

# Resend/Svix webhook signing secret. /api/email/webhook verifies the raw body
# and all Svix signature headers with the Resend SDK. The endpoint is disabled
# when this secret is missing.
# Get from the Resend dashboard → Webhooks → Signing secret.
EMAIL_WEBHOOK_SECRET=your-webhook-secret

# Application-owned outbound email delivery.
RESEND_API_KEY=re_your-key
EMAIL_FROM_ADDRESS=Prime Champs <outreach@your-domain.com>

# Python FastAPI backend base URL (bulk-enrich + 3 outreach routes proxy here).
BACKEND_URL=http://localhost:8000
AGENT_SERVER_URL=http://localhost:8000

# Shared secret between dashboard and backend. When set, the FastAPI agent API
# rejects any request without a matching X-API-Key header. Set the SAME value
# in the backend env and the dashboard env. Generate: openssl rand -hex 32
BACKEND_API_KEY=your-backend-api-key

# Comma-separated CORS origins the backend accepts (prod dashboard URL).
# BACKEND_CORS_ORIGINS=https://app.primechamps.com

# Enables the one-time schema-setup endpoints under /api/setup/* (they run
# DDL with the service key). Keep unset/false in production; set to "true"
# only while intentionally running a schema migration.
# ENABLE_SETUP_ROUTES=false

# -------------------------------------------
# AUTONOMOUS PIPELINE
# -------------------------------------------
# When "true", the backend auto-starts the pipeline scheduler on boot:
# enrich -> score -> generate -> send (send only touches APPROVED messages).
PIPELINE_AUTORUN_ENABLED=false
# Independent fail-closed gate for outbound Instagram DMs. Keep false until
# the staging workflow, approval gate, rate limits, and kill switch are verified.
INSTAGRAM_DM_SENDING_ENABLED=false
# Minutes between pipeline ticks.
PIPELINE_INTERVAL_MINUTES=60

# -------------------------------------------
# EXTERNAL INTEGRATIONS (Optional)
# -------------------------------------------
# GitHub - for MCP server integration
# Get from: https://github.com/settings/tokens
GITHUB_TOKEN=ghp_your-token

# Slack - for notifications (optional)
# SLACK_BOT_TOKEN=xoxb-your-token
# SLACK_TEAM_ID=your-team-id

# -------------------------------------------
# DATABASE (Alternative to Supabase)
# -------------------------------------------
# Direct PostgreSQL connection string
# Format: postgresql://user:password@host:port/database
# DATABASE_URL=postgresql://postgres:password@localhost:5432/primechamps

# -------------------------------------------
# APP CONFIG
# -------------------------------------------
NODE_ENV=development
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_URL=http://localhost:3000
# Vercel Cron bearer token for the daily channel delta sync and renewal.
CRON_SECRET=your-random-cron-secret

# -------------------------------------------
# NEXT.JS PUBLIC VARS
# -------------------------------------------
# These are exposed to the browser - only public keys!
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
