NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
SUPABASE_SECRET_KEY=sb_secret_your-key

# Public URLs used in invitations and provider webhooks.
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_URL=http://localhost:3000

# One-time only: existing Zac credentials used by /setup to create the first
# Supabase Auth owner. Remove this after the first-owner conversion succeeds.
AUTH_USERS=zac:replace-with-existing-password:Zac

# Encrypt OAuth access/refresh tokens. Generate with: openssl rand -base64 32
CHANNEL_TOKEN_ENCRYPTION_KEY=replace-with-32-byte-base64-key

# Microsoft Entra / Exchange Online
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=your-entra-tenant-id
MICROSOFT_REDIRECT_URI=http://localhost:3000/api/providers/outlook/callback
MICROSOFT_WEBHOOK_CLIENT_STATE=

# Meta / Instagram Business Login
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:3000/api/providers/instagram/callback
META_VERIFY_TOKEN=
META_API_VERSION=v26.0

# Protects /api/cron/channel-sync. Vercel supplies this bearer token to cron.
CRON_SECRET=

# Anthropic powers research scoring and meeting-intelligence extraction.
ANTHROPIC_API_KEY=
# OpenAI powers speaker-aware audio transcription; pasted transcripts do not
# require it.
OPENAI_API_KEY=

# Research discovery and public-data enrichment
PERPLEXITY_API_KEY=
APIFY_API_KEY=apify_api_your-token
# Optional actor overrides; these are the application defaults.
APIFY_GOOGLE_SEARCH_ACTOR=apify/google-search-scraper
APIFY_TIKTOK_PROFILE_ACTOR=clockworks/tiktok-profile-scraper
APIFY_ONLYFANS_PROFILE_ACTOR=hello.datawizards/onlyfans-scraper
APIFY_ONLYFANS_REVERSE_LOOKUP_ACTOR=sentry/onlyfans-reverse-lookup
APIFY_ONLYFANS_DISCOVERY_ACTOR=sentry/onlyfans-discovery-scraper

# Application-owned outbound email. Verify the sending domain in Resend and
# use the webhook endpoint /api/email/webhook for delivery events.
RESEND_API_KEY=

# Safety lock. Keep false until live outreach is explicitly approved.
OUTBOUND_SEND_ENABLED=false
EMAIL_FROM_ADDRESS=Prime Champs <outreach@your-domain.com>
EMAIL_WEBHOOK_SECRET=

# Python automation service used by enrichment/outreach jobs.
AGENT_SERVER_URL=http://127.0.0.1:8000
BACKEND_URL=http://127.0.0.1:8000
BACKEND_API_KEY=

# Keep both fail-closed until staging approval and send controls are verified.
PIPELINE_AUTORUN_ENABLED=false
INSTAGRAM_DM_SENDING_ENABLED=false
