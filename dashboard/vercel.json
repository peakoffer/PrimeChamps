{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "next build",
  "installCommand": "npm install",
  "crons": [
    {
      "path": "/api/cron/channel-sync",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/website-leads",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/research-stale-recovery",
      "schedule": "*/5 * * * *"
    }
  ]
}
